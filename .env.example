# Browser-safe Supabase values. These are intentionally public in Supabase apps.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-client-safe-publishable-key

# Do not place Supabase secret keys or service-role keys in NEXT_PUBLIC_ variables.
# This Phase 1A app does not require a service-role key.
