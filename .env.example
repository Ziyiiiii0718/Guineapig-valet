# Browser-safe Supabase values. These are intentionally public in Supabase apps.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-client-safe-publishable-key

# Do not place Supabase secret keys or service-role keys in NEXT_PUBLIC_ variables.
# PiggieVault does not require a Supabase service-role key.

# Server-only connection from Next.js to the separate FastAPI embedding service.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=replace-with-a-long-random-local-token
