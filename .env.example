# Browser-safe Supabase values. These are intentionally public in Supabase apps.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only values. Never expose service-role keys to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-server-only-maintenance

# Future AI service values. Not used in Phase 1A.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your-future-server-only-ai-service-key
